(executables
 (names
  check_properties
  check_api_consistency
  check_unknown_properties
  gen_property_names)
 (modules
  check_properties
  check_api_consistency
  check_unknown_properties
  gen_property_names)
 (libraries re unix cascade cascade_spec_inventory fmt))

(rule
 (alias runtest)
 (deps
  (:properties ../lib/properties.ml)
  (:properties_identity ../lib/properties_identity.ml)
  (:properties_intf ../lib/properties_intf.ml)
  (:script check_properties.exe))
 (action
  (run %{script})))

;; Run API consistency check and fail if issues are found
;; This ensures CSS API test consistency is maintained

(rule
 (alias runtest)
 (deps
  (glob_files ../lib/*_intf.ml)
  (glob_files ../lib/*.mli)
  (glob_files ../lib/variables*.ml)
  (glob_files ../test/test_*.ml)
  (glob_files_rec ../test/helpers/*_helpers.ml)
  (:script check_api_consistency.exe))
 (action
  (run %{script})))

;; Run with:
;;   dune exec scripts/check_unknown_properties.exe -- FILE1.css FILE2.css
;; Scans the inputs and reports each Unknown_property occurrence as
;; DROP_CANDIDATE (vendor prefix + modern is typed; add to vendor pair list)
;; or TYPE_ME (no typed handler yet).

;; lib/baseline.ml is built from lib/baseline.tsv by gen_baseline_ml. The data
;; comes from the web-features Baseline dataset; fetching it needs the network,
;; curl and jq, so no rule runs it. Refresh it by hand when browsers ship new
;; features:
;;
;;   scripts/gen_baseline.sh

(executable
 (name gen_baseline_ml)
 (modules gen_baseline_ml))

;; Mutation testing. Rewrites one token of one library source in a separate
;; checkout, rebuilds it and asks whether the suite noticed. Opt-in: a campaign
;; costs a full build and a full test run per mutant, so it has no alias.
;;
;;   git worktree add --detach /tmp/cascade-mut HEAD
;;   dune exec scripts/mutate.exe -- --work /tmp/cascade-mut --list
;;   dune exec scripts/mutate.exe -- --work /tmp/cascade-mut --sample 40 --seed 1
;;   dune exec scripts/mutate.exe -- --work /tmp/cascade-mut --only 1234,1235

(executable
 (name mutate)
 (modules mutate)
 (libraries unix fmt))
