; Shared runner reads traces/cases.trace.

(rule
 (alias runtest)
 (deps
  (source_tree traces))
 (action
  (run %{exe:../test.exe} %{project_root}/test/interop/satcss)))

; Refresh traces/cases.trace from the SatCSS corpus on demand.

(rule
 (alias regen-traces)
 (deps
  (source_tree scripts))
 (action
  (chdir
   scripts
   (run ./generate.sh))))
