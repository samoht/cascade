; The trace reader is a library so other harnesses can read the same corpus
; without a second copy of the record format.

(library
 (name trace_pairs)
 (modules trace_pairs)
 (libraries fmt))

(test
 (name test)
 (modules test)
 (libraries cascade alcotest unix re re.str fmt trace_pairs)
 (deps
  LICENSE
  UPSTREAM.md
  (source_tree traces)))

; Regenerate the Lightning-derived input corpus and cached oracle answers
; from the configured minifiers. Normal test runs read this trace and do not
; call external minifier CLIs. Only run on demand with REGEN=1.

(rule
 (alias regen-traces)
 (deps
  (alias traces/regen))
 (action (progn)))
