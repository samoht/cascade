(executable
 (public_name cascade)
 (name main)
 (libraries
  cascade
  cascade.info
  cascade.diff
  cascade.browser
  cmdliner
  fmt
  fmt.cli
  fmt.tty
  logs
  logs.fmt
  unix
  markup))

; The browser comparison's driver is compiled into the binary, so an installed
; cascade carries it and writes it beside the job it runs.

(rule
 (target browser_diff_js.ml)
 (deps browser_diff.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {js|")
    (cat browser_diff.js)
    (echo "|js}\n")))))
