(library
 (public_name cascade)
 (name cascade)
 ; Implementation modules stay available inside [cascade] without becoming
 ; usable [Cascade.*] modules or standalone odoc pages.  The prop_* modules
 ; hold the property families [Properties] includes; the *_intf modules share
 ; types between implementations and public interfaces; the rest are parser
 ; and optimizer implementation details behind the supported modules.
 (private_modules
  baseline
  block
  common
  custom_property_name
  declaration_intf
  factor
  flatten
  inline
  merge
  properties_intf
