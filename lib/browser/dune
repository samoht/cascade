; The node and headless-browser locator the render harnesses and the browser
; comparison share, so both find the same browser and report its absence the
; same way, and the comparison itself. Unwrapped: the harnesses read the
; locator as [Browser].

(library
 (name cascade_browser)
 (public_name cascade.browser)
 (wrapped false)
 (libraries unix cascade cascade.html))

; The comparison's driver is compiled into the library, so an installed cascade
; carries it and writes it beside the job it runs.

(rule
 (target browser_diff_js.ml)
 (deps browser_diff.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {js|")
    (cat browser_diff.js)
    (echo "|js}\n")))))
